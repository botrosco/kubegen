values:
  - name: Name
    type: string
    description: Name of helm chart
    required: true
  - name: Namespace
    type: string
    description: Namespace of workload resources
    required: true
  - name: OCI
    type: bool
    description: Use OCI for helm repo source type
    default: true
  - name: Url
    type: string
    description: URL of source
    default: ""
    required: true
  - name: Chart
    type: string
    description: Chart name, when it differs from the release name
    default: ""
  - name: Version
    type: string
    description: Chart version to pin (a floating chart is rarely what a gitops repo wants)
    default: ""
  - name: EmitNamespace
    type: bool
    description: Emit metadata.namespace (the consuming repo may declare the namespace in a kustomization instead)
    default: false
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: {{ .Name }}
{{- if .EmitNamespace }}
  namespace: {{ .Namespace }}
{{- end }}
spec:
{{- if .OCI }}
  type: oci
{{- end }}
  url: {{ .Url }}
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: {{ .Name }}
{{- if .EmitNamespace }}
  namespace: {{ .Namespace }}
{{- end }}
spec:
  interval: 10m
  timeout: 5m
  chart:
    spec:
      chart: {{ default .Name .Chart }}
{{- if .Version }}
      version: {{ .Version | quote }}
{{- end }}
      sourceRef:
        kind: HelmRepository
        name: {{ .Name }}
        namespace: {{ .Namespace }}
      interval: 10m
  # values:
