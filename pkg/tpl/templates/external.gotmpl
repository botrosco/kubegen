values:
  - name: Name
    type: string
    description: Name of workload resources
    required: true
  - name: Namespace
    type: string
    description: Namespace of workload resources
    required: true
  - name: TargetPort
    type: int
    description: Target port of upstream service
    required: true
  - name: Address
    type: string
    description: Address of the host already running the application
    required: true
  - name: Hostnames
    type: list
    description: Route hostnames (values file); no hostname is invented when empty
    default: []
  - name: GatewayParents
    type: list
    description: Route parents as {name, namespace, sectionName}
    default:
      - name: gateway
        namespace: istio-system
        sectionName: https
  - name: EmitNamespace
    type: bool
    description: Emit metadata.namespace (the consuming repo may declare the namespace in a kustomization instead)
    default: false
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: {{ .Name }}
{{- if .EmitNamespace }}
  namespace: {{ .Namespace }}
{{- end }}
  labels:
    kubernetes.io/service-name: {{ .Name }}
addressType: IPv4
ports:
  - name: http
    appProtocol: http
    protocol: TCP
    port: {{ .TargetPort }}
endpoints:
  - addresses:
      - {{ .Address | quote }}
---
apiVersion: v1
kind: Service
metadata:
  labels:
    endpointslice.kubernetes.io/skip-mirror: "true"
  name: {{ .Name }}
{{- if .EmitNamespace }}
  namespace: {{ .Namespace }}
{{- end }}
spec:
  ports:
    - name: http
      port: 80
      protocol: TCP
      targetPort: 80
  publishNotReadyAddresses: true
{{- if not (isZero .Hostnames) }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ .Name }}
{{- if .EmitNamespace }}
  namespace: {{ .Namespace }}
{{- end }}
spec:
  parentRefs:
{{- range .GatewayParents }}
    - name: {{ .name }}
      namespace: {{ .namespace }}
      sectionName: {{ .sectionName }}
{{- end }}
  hostnames:
{{- range .Hostnames }}
    - {{ . | quote }}
{{- end }}
  rules:
    - backendRefs:
        - name: {{ .Name }}
          port: 80
{{- end }}
